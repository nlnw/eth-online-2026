{
  "name": "sentinel402-gateway",
  "version": "1.0.0",
  "description": "Sentinel402 Gateway - Autonomous Web3 AI Agent Sentinel integrating The Graph Subgraph Studio, Bazantic x402 Micropayments, and ENSv2 Permissioned Resolvers",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "record": "bash scripts/record.sh",
    "record:browser": "LD_LIBRARY_PATH=\"$HOME/.local/share/mamba/envs/browser-libs/lib:$LD_LIBRARY_PATH\" node scripts/record_browser_demo.js",
    "play": "uvx asciinema play recordings/demo.cast",
    "generate-wallet": "node scripts/generate_wallet.js",
    "mcp": "node scripts/mcp_server.js",
    "voiceover": "uv run --with edge-tts python scripts/generate_voiceover.py",
    "mux": "bash scripts/mux_video.sh",
    "start": "node server/index.js",
    "install:all": "npm install && npm install --prefix client"
  },
  "keywords": [
    "the-graph",
    "subgraph-studio",
    "bazantic",
    "x402",
    "mpp",
    "ensv2",
    "sepolia",
    "ai-agent",
    "eth-online-2026"
  ],
  "author": "AgentCorp Engineering",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.63.0"
  }
}
